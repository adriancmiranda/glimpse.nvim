{
  "runtime": {
    "version": "LuaJIT"
  },
  "workspace": {
    "library": [
      "${3rd}/luv/library",
      "${3rd}/busted/library",
      "${3rd}/Neovim/library"
    ],
    "checkThirdParty": false
  },
  "diagnostics": {
    "globals": ["vim", "describe", "it", "before_each", "after_each", "assert"],
    "severity": {
      "duplicate-set-field": "Hint"
    },
    "disable": [
      "different-requires"
    ]
  }
}
